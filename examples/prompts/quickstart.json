{
  "stories": [
    {
      "id": "spleen",
      "name": "Radiology",
      "recipe": "vista3d",
      "labels": [
        "Spleen"
      ],
      "template_id": "Task09_Spleen",
      "modality": "CT",
      "learner": "VISTA3D-Spleen",
      "steps": [
        {
          "id": "project",
          "tool": "create_project",
          "arguments": {
            "name": "Radiology",
            "labels": []
          },
          "context": "workspace",
          "prompt": "Create a project called \"Radiology\"."
        },
        {
          "id": "import",
          "tool": "import_dataset_split",
          "arguments": {
            "template_id": "Task09_Spleen",
            "evaluation_percentage": 20,
            "include_masks": false,
            "limit": null,
            "channel": 0
          },
          "context": "web",
          "prompt": "Import Decathlon Spleen: 80% images only, 20% with evaluation labels."
        },
        {
          "id": "batch",
          "tool": "annotate_batch",
          "arguments": {
            "targets": [
              "Spleen"
            ],
            "model_id": "vista",
            "limit": 3,
            "submit_for_review": true
          },
          "context": "web",
          "prompt": "Annotate spleen in 3 images with VISTA3D; submit for review."
        },
        {
          "id": "total-batch",
          "tool": "annotate_batch",
          "arguments": {
            "targets": [
              "Spleen"
            ],
            "model_id": "total",
            "limit": 2,
            "submit_for_review": true
          },
          "context": "web",
          "prompt": "Annotate spleen in 2 images with TotalSegmentator CT; submit for review."
        },
        {
          "id": "clear",
          "tool": "clear_segments",
          "arguments": {
            "targets": [
              "Spleen"
            ],
            "scope": "current_slice"
          },
          "context": "ohif",
          "prompt": "Clear the spleen annotation on the current slice."
        },
        {
          "id": "astra",
          "tool": "annotate",
          "arguments": {
            "targets": [
              "Spleen"
            ],
            "model_id": "astra",
            "scope": "current_slice"
          },
          "context": "ohif",
          "prompt": "Annotate the spleen on the current slice using GPT Astra."
        },
        {
          "id": "correct",
          "tool": "review_annotation",
          "arguments": {
            "verdict": "accepted"
          },
          "context": "ohif",
          "prompt": "Accept my corrected segmentation."
        },
        {
          "id": "nn-start-1",
          "tool": "set_interaction_mode",
          "arguments": {
            "mode": "positive",
            "target": "Spleen",
            "model_name": "nnInteractive"
          },
          "context": "slicer",
          "prompt": "Start nnInteractive for spleen."
        },
        {
          "id": "nn-submit-1",
          "tool": "viewer_edit",
          "arguments": {
            "operation": "submit"
          },
          "context": "slicer",
          "prompt": "Submit this annotation for review."
        },
        {
          "id": "nn-start-2",
          "tool": "set_interaction_mode",
          "arguments": {
            "mode": "box",
            "target": "Spleen",
            "model_name": "nnInteractive"
          },
          "context": "slicer",
          "prompt": "Draw a spleen box with nnInteractive."
        },
        {
          "id": "nn-submit-2",
          "tool": "viewer_edit",
          "arguments": {
            "operation": "submit"
          },
          "context": "slicer",
          "prompt": "Submit this annotation for review."
        },
        {
          "id": "review",
          "tool": "review_saved_annotations",
          "arguments": {
            "scope": "pending",
            "verdict": "accepted",
            "dataset_use": "all"
          },
          "context": "web",
          "prompt": "Accept all pending reviews."
        },
        {
          "id": "recipes",
          "tool": "inspect_workspace",
          "arguments": {
            "collection": "training_recipes"
          },
          "context": "web",
          "prompt": "List all training recipes."
        },
        {
          "id": "model",
          "tool": "create_learner",
          "arguments": {
            "recipe": "vista3d",
            "name": "VISTA3D-Spleen",
            "targets": [
              "Spleen"
            ],
            "start_now": false
          },
          "context": "web",
          "prompt": "Based on VISTA3D, create model \"VISTA3D-Spleen\" for spleen."
        },
        {
          "id": "train",
          "tool": "start_training",
          "arguments": {
            "learner_name": "VISTA3D-Spleen",
            "evaluation_set_name": "Fixed evaluation set"
          },
          "context": "web",
          "prompt": "Fine-tune VISTA3D-Spleen on approved masks; use the fixed evaluation set."
        },
        {
          "id": "compare",
          "tool": "evaluate_candidate",
          "arguments": {
            "candidate_name": "VISTA3D-Spleen",
            "baseline_name": "VISTA3D",
            "evaluation_set_name": "Fixed evaluation set"
          },
          "context": "web",
          "prompt": "Compare VISTA3D-Spleen with VISTA3D on the fixed evaluation set."
        },
        {
          "id": "predict",
          "tool": "annotate",
          "arguments": {
            "targets": [
              "Spleen"
            ],
            "model_id": "trained",
            "scope": "full"
          },
          "context": "ohif",
          "prompt": "Segment the spleen in the whole volume using VISTA3D-Spleen."
        }
      ]
    },
